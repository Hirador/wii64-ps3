#---------------------------------------------------------------------------------
# Clear the implicit built in rules
#---------------------------------------------------------------------------------
.SUFFIXES:
#---------------------------------------------------------------------------------
ifeq ($(strip $(PSL1GHT)),)
$(error "Please set PSL1GHT in your environment. export PSL1GHT=<path>")
endif

include $(PSL1GHT)/ppu_rules

#---------------------------------------------------------------------------------
# TARGET is the name of the output
# BUILD is the directory where object files & intermediate files will be placed
# SOURCES is a list of directories containing source code
# INCLUDES is a list of directories containing extra header files
#---------------------------------------------------------------------------------
#TARGET		:=	$(notdir $(CURDIR))
TARGET		:=	ps364_glN64

# Package identity, used by `make -f Makefile.ps3 pkg`. ppu_rules defaults these
# with ?=, so assigning here overrides them. APPID must be 9 alphanumeric
# characters -- the PS3 silently rewrites the install directory otherwise.
TITLE		:=	Wii64 PS3
APPID		:=	WII640001
CONTENTID	:=	UP0001-$(APPID)_00-0000000000000000

# ppu_rules builds EBOOT.BIN with make_self_npdrm, which retail-signs and needs
# key material the toolchain does not ship -- it segfaults on real input rather
# than reporting the missing keys. Homebrew wants a fake-signed NPDRM self
# anyway, which is what fself.py produces and what HEN/CFW will load.
SELF_NPDRM	:=	fself.py --npdrm
BUILD		:=	build
SOURCES		:=	gc_audio gc_input gc_memory rsp_hle glN64_GX r4300 r4300/ppc main main/debug fileBrowser libgui menu
DATA		:=	data
SHADERS		:=	shaders
INCLUDES	:=

#---------------------------------------------------------------------------------
# options for code generation
#---------------------------------------------------------------------------------

# Add -DSHOW_DEBUG for on-screen debug output.
COMMONFLAGS	= -g -O2 -Wall -mcpu=cell $(MACHDEP) $(INCLUDE) \
			-fno-exceptions -Wno-unused-parameter -pipe -DUSE_EXPANSION -D__BIG_ENDIAN__ \
			-DPPC -D__PPC__ -D_BIG_ENDIAN -DPS3 -D__LINUX__ -DPPC_DYNAREC -DUSE_RECOMP_CACHE

# -fgnu89-inline: this codebase predates C99 inline semantics. It defines
# functions such as invalid_code_get/set and blocks_get/set as a bare `inline`
# in a .c file and declares them `inline` in the matching header. Under GCC's
# default gnu11 that emits no externally visible definition, so linking fails
# with ~50 undefined references. GNU89 semantics emit the out-of-line copy the
# code expects. C only -- GCC rejects this option for C++.
CFLAGS		=	$(COMMONFLAGS) -fgnu89-inline

# -Wno-narrowing: PSL1GHT's vectormath/cpp/quat_aos.h brace-initialises
# 0x80000000 into a signed vec_int4, which GCC 7's default gnu++14 rejects as a
# narrowing conversion. The header is out of our control, so demote it.
CXXFLAGS	=	$(COMMONFLAGS) -Wno-narrowing

LDFLAGS		=	$(MACHDEP) -Wl,-Map,$(notdir $@).map

#---------------------------------------------------------------------------------
# any extra libraries we wish to link with the project
#---------------------------------------------------------------------------------
LIBS	:=	-laudio -lsimdmath -lrsx -lgcm_sys -lio -lsysmodule -lsysutil -lrt -llv2 -lm

#---------------------------------------------------------------------------------
# list of directories containing libraries, this must be the top level containing
# include and lib
#---------------------------------------------------------------------------------
LIBDIRS	:=

#---------------------------------------------------------------------------------
# no real need to edit anything past this point unless you need to add additional
# rules for different file extensions
#---------------------------------------------------------------------------------
ifneq ($(BUILD),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export OUTPUT	:=	$(CURDIR)/$(TARGET)

export VPATH	:=	$(foreach dir,$(SOURCES),$(CURDIR)/$(dir)) \
					$(foreach dir,$(DATA),$(CURDIR)/$(dir)) \
					$(foreach dir,$(SHADERS),$(CURDIR)/$(dir))

export DEPSDIR	:=	$(CURDIR)/$(BUILD)

#---------------------------------------------------------------------------------
# automatically build a list of object files for our project
#---------------------------------------------------------------------------------
CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
sFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
SFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.S)))
BINFILES	:=	$(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.*)))
VCGFILES	:=	$(foreach dir,$(SHADERS),$(notdir $(wildcard $(dir)/*.vcg)))
FCGFILES	:=	$(foreach dir,$(SHADERS),$(notdir $(wildcard $(dir)/*.fcg)))

VPOFILES	:=	$(VCGFILES:.vcg=.vpo)
FPOFILES	:=	$(FCGFILES:.fcg=.fpo)

#---------------------------------------------------------------------------------
# use CXX for linking C++ projects, CC for standard C
#---------------------------------------------------------------------------------
ifeq ($(strip $(CPPFILES)),)
	export LD	:=	$(CC)
else
	export LD	:=	$(CXX)
endif

# Exported so the sub-make can depend on the shader objects; CPPFILES and
# friends only exist in this branch.
export SHADER_OFILES	:=	$(addsuffix .o,$(VPOFILES)) \
					$(addsuffix .o,$(FPOFILES))

export OFILES	:=	$(addsuffix .o,$(BINFILES)) \
					$(SHADER_OFILES) \
					$(CPPFILES:.cpp=.o) $(CFILES:.c=.o) \
					$(sFILES:.s=.o) $(SFILES:.S=.o)

#---------------------------------------------------------------------------------
# build a list of include paths
#---------------------------------------------------------------------------------
export INCLUDE	:=	$(foreach dir,$(INCLUDES), -I$(CURDIR)/$(dir)) \
					$(foreach dir,$(LIBDIRS),-I$(dir)/include) \
					$(LIBPSL1GHT_INC) \
					-I$(PORTLIBS)/include \
					-I$(CURDIR)/$(BUILD)

#---------------------------------------------------------------------------------
# build a list of library paths
#---------------------------------------------------------------------------------
export LIBPATHS	:=	$(foreach dir,$(LIBDIRS),-L$(dir)/lib) \
					$(LIBPSL1GHT_LIB) \
					-L$(PORTLIBS)/lib

export OUTPUT	:=	$(CURDIR)/$(TARGET)
.PHONY: $(BUILD) clean pkg

#---------------------------------------------------------------------------------
# The '+' prefix and $(MAKE) hand the jobserver down to the sub-make; with a
# bare `make` it printed "jobserver unavailable: using -j1" and built serially
# however high -j was set.
$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	+@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile.ps3

#---------------------------------------------------------------------------------
clean:
	@echo clean ...
	@rm -fr $(BUILD) $(OUTPUT).elf $(OUTPUT).self $(OUTPUT)*.pkg

#---------------------------------------------------------------------------------
run:
	ps3load $(OUTPUT).self

#---------------------------------------------------------------------------------
# Build an installable package.
#
# This deliberately does NOT use the %.pkg rule from ppu_rules. That rule feeds
# fself/make_self_npdrm from $(BUILDDIR)/$(TARGET).elf, which is only a side
# effect of the %.self rule -- so whenever the .self is already up to date the
# strip step is skipped, the input file never appears, and the pkg is built with
# no EBOOT.BIN in it. It still exits 0, producing a ~15K package that installs
# and does nothing. Doing the steps here keeps the inputs explicit.
pkg: $(BUILD)
	@echo building pkg ... $(TARGET).pkg
	@mkdir -p $(BUILD)/pkg/USRDIR
	@cp $(ICON0) $(BUILD)/pkg/ICON0.PNG
	@$(STRIP) $(OUTPUT).elf -o $(BUILD)/$(TARGET).stripped.elf
	@$(SPRX) $(BUILD)/$(TARGET).stripped.elf
	@$(SELF_NPDRM) $(BUILD)/$(TARGET).stripped.elf $(BUILD)/pkg/USRDIR/EBOOT.BIN
	@$(SFO) --title "$(TITLE)" --appid "$(APPID)" -f $(SFOXML) $(BUILD)/pkg/PARAM.SFO
	@$(PKG) --contentid $(CONTENTID) $(BUILD)/pkg/ $(OUTPUT).pkg
	@test -s $(BUILD)/pkg/USRDIR/EBOOT.BIN \
		|| { echo "FATAL: EBOOT.BIN is empty or missing"; exit 1; }
	@echo "  EBOOT.BIN $$(stat -c%s $(BUILD)/pkg/USRDIR/EBOOT.BIN) bytes"


#---------------------------------------------------------------------------------
else

DEPENDS	:=	$(OFILES:.o=.d)

#---------------------------------------------------------------------------------
# main targets
#---------------------------------------------------------------------------------
$(OUTPUT).self: $(OUTPUT).elf
$(OUTPUT).elf:	$(OFILES)

# The Cg shaders are turned into objects by bin2o, which also emits the
# combined_shader_vpo.h / combined_shader_fpo.h that OpenGL.h and the libgui
# renderers include. Nothing expressed that dependency, so a parallel build
# could compile those sources before the headers existed and fail with
# "combined_shader_vpo.h: No such file or directory". It only ever worked
# because the build was accidentally serial.
$(filter-out $(SHADER_OFILES),$(OFILES)): $(SHADER_OFILES)

#---------------------------------------------------------------------------------
# This rule links in binary data with the .bin extension
#---------------------------------------------------------------------------------
%.z64.o	:	%.z64
#---------------------------------------------------------------------------------
	@echo $(notdir $<)
	$(bin2o)

#---------------------------------------------------------------------------------
%.vpo.o	:	%.vpo
#---------------------------------------------------------------------------------
	@echo $(notdir $<)
	@$(bin2o)

#---------------------------------------------------------------------------------
%.fpo.o	:	%.fpo
#---------------------------------------------------------------------------------
	@echo $(notdir $<)
	@$(bin2o)

-include $(DEPENDS)

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
